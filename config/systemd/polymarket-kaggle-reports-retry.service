[Unit]
Description=Retry pending local Polymarket reports from Kaggle
After=network-online.target

[Service]
Type=oneshot
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
WorkingDirectory=%h/poly-market-analysis
ExecStart=%h/poly-market-analysis/.venv-btc5m/bin/python -u %h/poly-market-analysis/scripts/polymarket_kaggle_reports.py --kind all
TimeoutStartSec=infinity
StandardOutput=journal
StandardError=journal
